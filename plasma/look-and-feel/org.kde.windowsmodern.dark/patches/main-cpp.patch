diff --git a/src/frontend/greeter/main.cpp b/src/frontend/greeter/main.cpp
index 8a5d230..edc2472 100644
--- a/src/frontend/greeter/main.cpp
+++ b/src/frontend/greeter/main.cpp
@@ -9,0 +10,2 @@
+#include <QFile>
+#include <QStandardPaths>
@@ -12,0 +15 @@
+#include <QQuickItem>
@@ -51,0 +55,12 @@ public:
+    ~LoginGreeter() override
+    {
+        // Views borrow m_engine. Destroy them before the shared engine is released.
+        const auto views = findChildren<QQuickView *>(Qt::FindDirectChildrenOnly);
+        for (QQuickView *view : views) {
+            if (QQuickItem *focusItem = view->activeFocusItem()) {
+                focusItem->setFocus(false);
+            }
+            delete view;
+        }
+    }
+
@@ -78 +93,21 @@ private:
-        window->setSource(QUrl("qrc:/qt/qml/org/kde/plasma/login/Main.qml"));
+        const QUrl stockSource(QStringLiteral("qrc:/qt/qml/org/kde/plasma/login/Main.qml"));
+        const QString relativeTheme = QStringLiteral("plasma/look-and-feel/org.kde.windowsmodern.dark/contents/lockscreen/Main.qml");
+        QString themePath;
+        if (s_testMode) {
+            themePath = qEnvironmentVariable("WINDOWS_MODERN_GREETER_THEME");
+            if (themePath.isEmpty()) {
+                themePath = QStandardPaths::locate(QStandardPaths::GenericDataLocation, relativeTheme);
+            }
+        } else {
+            // Before login, only load the administrator-installed theme.
+            themePath = QStringLiteral("/usr/share/") + relativeTheme;
+        }
+        if (!themePath.isEmpty() && QFile::exists(themePath)) {
+            window->setSource(QUrl::fromLocalFile(themePath));
+            if (window->status() == QQuickView::Error || !window->rootObject()) {
+                qWarning() << "Windows Modern greeter could not load; using the built-in login screen";
+                window->setSource(stockSource);
+            }
+        } else {
+            window->setSource(stockSource);
+        }
